---
layout: sitemap.liquid
permalink: "/sitemap.xml"
---
  <url>
    <loc>{{ site.base_url }}/</loc>
  </url>
  <url>
    <loc>{{ site.base_url }}/pages/ai-tips/</loc>
    <lastmod>2026-03-12</lastmod>
  </url>
{% assign posts_sorted = collections.posts.pages | sort: "published_date" | reverse %}
{% for post in posts_sorted %}
  <url>
    <loc>{{ site.base_url }}{{ post.permalink | prepend: "/" }}</loc>
    {% if post.published_date %}
    <lastmod>{{ post.published_date | date: "%Y-%m-%d" }}</lastmod>
    {% endif %}
  </url>
{% endfor %}
