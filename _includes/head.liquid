<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#454545">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{% if page.title %}{{ page.title | escape }}{% else %}{{ site.title | escape }}{% endif %}</title>
  {% assign meta_description = "" %}
  {% assign page_content_text = page.content | strip_html | strip_newlines | replace: "  ", " " | replace: "  ", " " | replace: "  ", " " | strip %}
  {% if page.description != blank %}
    {% assign meta_description = page.description | strip_html | strip_newlines | strip %}
  {% elsif page.excerpt != blank %}
    {% assign meta_description = page.excerpt | strip_html | strip_newlines | strip %}
  {% endif %}
  {% if meta_description == blank and page.collection == "posts" %}
    {% assign meta_description = page_content_text %}
  {% endif %}

  {% assign is_home = false %}
  {% if page.permalink == "index.html" or page.permalink == "/" or page.url == "index.html" or page.url == "/" %}
    {% assign is_home = true %}
  {% endif %}

  {% if meta_description == blank %}
    {% assign meta_description = site.description %}
  {% endif %}

  {% if is_home and page_content_text != blank and meta_description != page_content_text %}
    {% assign meta_description = meta_description | append: " — " | append: page_content_text %}
  {% endif %}
  <meta name="description" content="{{ meta_description | escape | truncate: 160 }}">

  <link rel="stylesheet" href="{{ "/css/main.css" | prepend: site.base_url }}">
  <link rel="canonical" href="{{ site.base_url }}/{{ page.permalink }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ "/feed.xml" | prepend: site.base_url }}">
</head>
