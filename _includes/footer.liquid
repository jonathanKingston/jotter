<footer class="site-footer">

  <div class="wrapper">
    <p>
      <a class="page-link" href="{{ "/pages/ai-tips/" | prepend: site.base_url }}">AI Tips</a>
    </p>
    <ul class="social-media-list">
      {% if site.data.github_username %}
      <li>
        {% include "icon-github.html" %}
      </li>
      {% endif %}

      {% if site.data.linkedin_url %}
      <li>
        {% include "icon-linkedin.html" %}
      </li>
      {% endif %}

      {% if site.data.bsky_url %}
      <li>
        {% include "icon-bluesky.html" %}
      </li>
      {% endif %}

      {% if site.data.mastodon_url %}
      <li>
        {% include "icon-mastodon.html" %}
      </li>
      {% endif %}

      {% if site.data.twitter_username %}
      <li>
        {% include "icon-twitter.html" %}
      </li>
      {% endif %}
    </ul>
  </div>

</footer>
